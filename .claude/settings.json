{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/prompt-router.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-git-guard.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/pre-test-in-docker.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/agent-read-only-bash.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-test-reminder.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/post-edit-build-rules-note.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/stop-review-gate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-end-metrics.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(npm test -- --watch=false:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git worktree list:*)",
      "Bash(bash tools/checks/check-context-refs.sh)",
      "Bash(bash tools/checks/check-context-refs.test.sh)",
      "Bash(bash .claude/hooks/pre-git-guard.test.sh)",
      "Bash(bash .claude/hooks/stop-review-gate.test.sh)",
      "Bash(bash .claude/hooks/session-start.test.sh)",
      "Bash(bash .claude/hooks/post-edit-build-rules-note.test.sh)",
      "Bash(bash .claude/hooks/post-edit-test-reminder.test.sh)",
      "Bash(bash .claude/hooks/prompt-router.test.sh)",
      "Bash(bash .claude/hooks/session-end-metrics.test.sh)",
      "Bash(bash .claude/workflows/explorer-review.test.sh)",
      "Bash(tools/checks/in-docker.sh:*)",
      "Bash(bash tools/checks/check-hidden-text.sh)",
      "Bash(bash tools/checks/check-hidden-text.test.sh)",
      "Bash(bash tools/checks/in-docker.test.sh)",
      "Bash(tools/dev/token-usage.sh:*)",
      "Bash(bash .claude/hooks/pre-test-in-docker.test.sh)",
      "Bash(bash .claude/hooks/agent-read-only-bash.test.sh)"
    ]
  }
}
